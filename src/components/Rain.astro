---
---
<canvas id="rain" aria-hidden="true"></canvas>

<style>
  #rain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.18;
  }
</style>

<script>
  const canvas = document.getElementById('rain');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const glyphs = '01';
    const size = 15;
    let w = 0, h = 0, cols = 0;
    let drops = [];
    let timer;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    function resize() {
      if (!canvas || !ctx) return;
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      cols = Math.ceil(w / size);
      drops = new Array(cols).fill(1).map(() => Math.random() * -40);
    }

    function draw() {
      if (!ctx) return;
      ctx.fillStyle = 'rgba(10, 14, 11, 0.09)';
      ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#22C55E';
      ctx.font = size + 'px ui-monospace, monospace';
      for (let i = 0; i < cols; i++) {
        const glyph = glyphs.charAt(Math.floor(Math.random() * glyphs.length));
        ctx.fillText(glyph, i * size, drops[i] * size);
        if (drops[i] * size > h && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }

    function start() {
      if (timer !== undefined) return;
      timer = window.setInterval(draw, 70);
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    resize();
    window.addEventListener('resize', resize);

    if (!reduced.matches) start();

    reduced.addEventListener('change', () => {
      if (reduced.matches) stop(); else start();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!reduced.matches) start();
    });
  }
</script>
