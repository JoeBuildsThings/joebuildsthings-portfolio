---
interface Props {
  label?: string;
  class?: string;
}
const { label = 'joe@osogbo: ~', class: className = '' } = Astro.props;
---

<div class:list={['terminal', className]}>
  <div class="bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <p>{label}</p>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .terminal {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    border-radius: 6px;
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-line);
    background: #070A08;
  }

  .bar span {
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-line);
    background: transparent;
  }

  .bar p {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .body {
    padding: 18px 16px 22px;
    font-size: 14px;
    line-height: 1.95;
  }

  .body :global(.p) {
    color: var(--color-accent);
    margin-right: 6px;
  }

  .body :global(.out) {
    color: var(--color-muted);
  }

  .body :global(.caret) {
    display: inline-block;
    width: 9px;
    height: 17px;
    background: var(--color-accent);
    vertical-align: -3px;
    animation: blink 1.05s steps(1) infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
